# Copy to .env and fill in. .env is in .gitignore and never committed.
SEC_USER_AGENT=Your Name you@example.com
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
MASSIVE_API_KEY=
OLLAMA_MODEL=qwen3:8b
# 5120 fits qwen3:8b on an 8 GB GPU; false turns off qwen3's reasoning (leave empty for other models)
OLLAMA_NUM_CTX=5120
OLLAMA_THINK=false
